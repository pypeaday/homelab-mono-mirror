# actual_import service
# ACTUAL_PASSWORD is set in the Komodo stack's Environment (interpolated into
# compose via ${ACTUAL_PASSWORD}) — periphery can't read /tank host paths.
# Non-secret config lives in docker-compose.yml (server URL, sync ID, dirs).
# Optional overrides:
# IMPORT_SWEEP_SEC=60       # how often to scan the drop folder
# DRY_RUN=1                 # parse + call CLI with --dry-run, never writes
# ACTUAL_E2E_PASSWORD=      # only if the budget file has E2E encryption (ours doesn't)
# NODE_TLS_REJECT_UNAUTHORIZED=0  # only for self-signed certs — we use http on phantomlink
