# Forgejo PAT used to clone + push branches and open/label PRs.
# Convention: reuse the dev token — same as ~/.local/share/devin/forgejo-token
# (verified write access on nic/homelab-mono).
# For cleaner PR attribution you can instead create a dedicated PAT or
# "renovate" bot account at https://git.paynepride.com/user/settings/applications
# (needs write on repository + issue/pull_request).
RENOVATE_TOKEN=

# Runner config (non-secret)
RENOVATE_PLATFORM=forgejo
RENOVATE_ENDPOINT=https://git.paynepride.com/api/v1
RENOVATE_REPOSITORIES=nic/homelab-mono
LOG_LEVEL=info
