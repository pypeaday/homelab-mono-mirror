KANBOARD_URL=http://kanboard-new
KANBOARD_TOKEN=<jsonrpc token — same as ~/.local/share/devin/kanboard-token>
FORGEJO_API_URL=https://git.paynepride.com/api/v1
FORGEJO_TOKEN=<forgejo api token — same as ~/.local/share/devin/forgejo-token>
FORGEJO_WEBHOOK_SECRET=<openssl rand -hex 20 — also set on the Forgejo user/org hook>
DEFAULT_PROJECT=11
REPO_MAP={"nic/digital-harbor-ops": 3, "nic/DigitalHarbor": 3, "nic/sites-dashboard": 3, "nic/*website*": 3, "nic/homelab-mono": 8, "nic/ansible-*": 8, "nic/dotfiles": 8}
