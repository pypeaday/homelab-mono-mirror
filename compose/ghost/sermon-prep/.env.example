# Login password for the web app. Required — without it the app is wide open.
APP_PASSWORD=changeme
# Optional: changes the session-cookie signing key (defaults to APP_PASSWORD).
# Set a separate value so rotating the password doesn't share key material.
AUTH_SECRET=
# Optional: api.esv.org key — enables ESV in the translation picker (live API
# lookup at insert time; BSB/KJV stay vendored/offline).
ESV_API_KEY=
