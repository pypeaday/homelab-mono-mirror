# Server name as it appears in the Komodo UI (defaults to aurora).
# For ghost-vault: PERIPHERY_CONNECT_AS=ghost-vault
PERIPHERY_CONNECT_AS=aurora

# Created in Komodo UI: Settings -> Servers -> "Create Onboarding Key".
# One-time use for the initial key exchange; can be blanked after the
# server shows OK.
PERIPHERY_ONBOARDING_KEY=

# Where stack files and cloned repos live on this node (aurora convention:
# /var/docker-storage-zfs/<app>). Must exist on the host.
PERIPHERY_ROOT_DIRECTORY=/var/docker-storage-zfs/komodo
